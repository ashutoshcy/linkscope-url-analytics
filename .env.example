# Development default: SQLite, no external services
DATABASE_URL=sqlite:///./linkscope.db
# Generate a random secret for production: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-replace-before-deployment
APP_ENV=development
# When deployed, set the public URL and use HTTPS
# PUBLIC_BASE_URL=https://your-domain.example
# COOKIE_SECURE=true
# To use PostgreSQL via Docker Compose:
# DATABASE_URL=postgresql+psycopg://linkscope:dev_password_change_me@localhost:5432/linkscope
# Optional Redis (enable service with docker compose up -d redis)
# REDIS_URL=redis://localhost:6379/0
